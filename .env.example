# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server/test only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The one email allowed to sign in. Do not commit the real value.
ALLOWED_EMAIL=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Postgres connection string, used only by `npm run db:push` to apply migrations.
# Supabase → Connect → Session pooler URI (with your database password filled in).
SUPABASE_DB_URL=

# E2E only: a separate, pre-created test account (Supabase → Authentication → Users).
# Never your real account. Tests sign in via a service-role magic link and clean up after themselves.
E2E_EMAIL=
